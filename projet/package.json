{
  "name": "christmas-quest",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node tests/visibility.mjs && node tests/acceptance.mjs",
    "test:gameplay": "node tests/gameplay.mjs",
    "test:minigames": "node tests/minigame-logic.mjs && node tests/minigames-controls.mjs && node tests/minigame-balance.mjs",
    "test:minigames:visual": "node tests/minigames-visual.mjs",
    "test:visual": "node tests/smoke.mjs",
    "test:chalet-list": "node tests/chalet-list-visual.mjs",
    "test:mobile-fullscreen": "node tests/mobile-fullscreen.mjs",
    "test:visual-regressions": "node tests/visual-regressions.mjs",
    "test:unit": "node tests/visibility.mjs",
    "test:acceptance": "node tests/acceptance.mjs"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.64.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
